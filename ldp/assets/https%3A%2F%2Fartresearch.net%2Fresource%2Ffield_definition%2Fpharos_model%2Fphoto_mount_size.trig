  _:genid-8a7f458ae806c8246855210832508941-3afdc a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX meta: <https://artresearch.net/resource/pharos/vocab/meta/>

SELECT DISTINCT ?value WHERE {
  ?subject crm:P46_is_composed_of ?mount .
  ?mount crm:P2_has_type meta:photo_mount ;
    crm:P43_has_dimension/crm:P3_has_note ?value .
}""" .
  
