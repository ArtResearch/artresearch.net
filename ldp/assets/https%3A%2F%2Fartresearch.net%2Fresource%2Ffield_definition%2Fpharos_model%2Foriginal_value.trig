      <http://www.w3.org/ns/ldp#Resource>;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> <http://www.w3.org/2001/XMLSchema#anyURI>;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:genid-c0d8fea2206f4bb8be340a4adaf09576-tvkafx;
    <http://www.w3.org/2000/01/rdf-schema#label> "Original Value";
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:genid-c0d8fea2206f4bb8be340a4adaf09576-5ykhea;
    <http://www.w3.org/ns/prov#wasAttributedTo> <http://www.researchspace.org/resource/user/admin>;
