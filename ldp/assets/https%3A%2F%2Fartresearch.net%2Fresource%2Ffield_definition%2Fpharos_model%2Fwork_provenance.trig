  _:genid-a40de577d52497c444692a4aa564c22c-5744c a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> "INSERT { $subject ?predicate $value} WHERE {}" .
  
  _:genid-f3cd4634701459d531e079f2a03ac696-dc697 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>

SELECT ?value ?provUri WHERE {
  {
    ?subject crm:P24i_changed_ownership_through ?value .
    BIND(crm:P24i_changed_ownership_through AS ?property)
  }
  UNION
  {
    ?subject crm:P30i_custody_transferred_through ?value .
    BIND(crm:P30i_custody_transferred_through AS ?property)
  }
  # the archive's claim of it, for the marks
  BIND(IRI(CONCAT(\"https://artresearch.net/resource/e13/\", SHA256(CONCAT(STR(?subject), STR(?property), STR(?value))))) AS ?provUri)
}""" .
  
  <http://www.researchspace.org/resource/system/fieldDefinitionContainer> <http://www.w3.org/ns/ldp#contains>
      <https://artresearch.net/resource/field_definition/pharos_model/work_provenance> .
}
