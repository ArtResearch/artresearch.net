
<https://artresearch.net/resource/field_definition/pharos_model/subject_umbrella/context> {
  <https://artresearch.net/resource/field_definition/pharos_model/subject_umbrella> a
      <http://www.researchspace.org/resource/system/fields/Field>, <http://www.w3.org/ns/prov#Entity>,
      <http://www.w3.org/ns/ldp#Resource>;
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> <http://www.w3.org/2001/XMLSchema#anyURI>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Subject division";
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:genid-subject-umbrella-select;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:genid-subject-umbrella-insert;
    <http://www.w3.org/ns/prov#wasAttributedTo> <http://www.researchspace.org/resource/user/admin>;
    <http://www.w3.org/ns/prov#generatedAtTime> "2026-10-08T00:00:00.000+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .

  _:genid-subject-umbrella-select a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>

SELECT DISTINCT ?value WHERE {
  ?subject crm:P127_has_broader_term+ ?value .
  FILTER EXISTS { ?value crm:P127_has_broader_term/crm:P127_has_broader_term ?grandparent }
  FILTER NOT EXISTS { ?value crm:P127_has_broader_term/crm:P127_has_broader_term/crm:P127_has_broader_term ?ancestor }
}""" .

  _:genid-subject-umbrella-insert a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> "INSERT { $subject ?predicate $value} WHERE {}" .

  <http://www.researchspace.org/resource/system/fieldDefinitionContainer> <http://www.w3.org/ns/ldp#contains>
      <https://artresearch.net/resource/field_definition/pharos_model/subject_umbrella> .
}
