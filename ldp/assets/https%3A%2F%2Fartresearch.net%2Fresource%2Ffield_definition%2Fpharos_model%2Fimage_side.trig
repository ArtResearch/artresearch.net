  _:genid-image_side-select-264FD80C6907885FCAFE2F4963FF24AC a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX meta: <https://artresearch.net/resource/pharos/vocab/meta/>

